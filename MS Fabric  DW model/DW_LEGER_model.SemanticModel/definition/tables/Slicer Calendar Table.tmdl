table 'Slicer Calendar Table'
	lineageTag: 67543215-7b59-412a-b51f-cb2104aedccd
	sourceLineageTag: [dbo].[Calendar_slicer]

	measure 'Month_Prev m' =
			
			VAR _SlicerMonth = SELECTEDVALUE('Slicer Calendar Table'[Month])
			RETURN
			IF(
			    NOT ISBLANK(_SlicerMonth),
			    _SlicerMonth - 1,
			    0
			)
		formatString: 0
		lineageTag: d0c693fd-405e-4828-be15-dc643d608bad

		changedProperty = Name

	measure 'Selected Quarter M' =
			VAR _Selected = SELECTEDVALUE('Slicer Calendar Table'[Quarter Number])
			RETURN
			IF(ISBLANK(_Selected), "All Quarters", FORMAT(_Selected, "0"))
		lineageTag: cc829711-c88d-4829-8552-d2b2eedc3cd9

		changedProperty = Name

	measure 'Selected_Month M' =
			
			VAR _Selected = SELECTEDVALUE('Slicer Calendar Table'[Month])
			RETURN
			IF(ISBLANK(_Selected), "All Months", FORMAT(_Selected, "0"))
		lineageTag: d00d487c-953f-4d3a-924e-c4a0891a6bc3

		changedProperty = Name

	measure 'Selected_Year M' =
			
			VAR _Selected = SELECTEDVALUE('Slicer Calendar Table'[Year])
			RETURN
			IF(ISBLANK(_Selected), "All Years", FORMAT(_Selected, "0"))
		lineageTag: 139ef3c8-4830-473e-ac19-bd2b7cabb28b

		changedProperty = Name

	measure Year_Prev =
			
			VAR _MaxYear = MAX('Slicer Calendar Table'[Year]) // Or YEAR(TODAY())
			VAR _ColumnYear =SELECTEDVALUE( 'Slicer Calendar Table'[Year])
			RETURN
			IF(
			    (_MaxYear - _ColumnYear) <= 1 && (_MaxYear - _ColumnYear) >= 0,
			    _ColumnYear,
			    0
			)
		formatString: 0
		lineageTag: 0de82518-fc37-481f-9cf5-84de8869695c

		changedProperty = Name

