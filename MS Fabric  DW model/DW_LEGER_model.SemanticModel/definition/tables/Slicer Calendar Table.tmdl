	column 'Month Combined' =
			
			SWITCH(
			    TRUE(),
			    'Slicer Calendar Table'[Month Name] = "January",   "01 - Jan",
			    'Slicer Calendar Table'[Month Name] = "February",  "02 - Feb",
			    'Slicer Calendar Table'[Month Name] = "March",     "03 - Mar",
			    'Slicer Calendar Table'[Month Name] = "April",     "04 - Apr",
			    'Slicer Calendar Table'[Month Name] = "May",       "05 - May",
			    'Slicer Calendar Table'[Month Name] = "June",      "06 - Jun",
			    'Slicer Calendar Table'[Month Name] = "July",      "07 - Jul",
			    'Slicer Calendar Table'[Month Name] = "August",    "08 - Aug",
			    'Slicer Calendar Table'[Month Name] = "September", "09 - Sep",
			    'Slicer Calendar Table'[Month Name] = "October",   "10 - Oct",
			    'Slicer Calendar Table'[Month Name] = "November",  "11 - Nov",
			    'Slicer Calendar Table'[Month Name] = "December",  "12 - Dec"
			)
		lineageTag: 3c5f9c05-d81f-4c91-bbf8-7eb18999d463
		summarizeBy: none
		expressionContext: userContext

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column Quarter = "Q"& FORMAT ( 'Slicer Calendar Table'[CalendarDate], "Q" )
		lineageTag: 432e26f9-75c6-4b6f-af9b-dab55979738c
