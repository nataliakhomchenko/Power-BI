/// Measures for Income Statement reports: Current, YTD (Year to Date) and YTD SPLY (Year to Date Same Period Last Year)
table Measures_IncomeStatements
	lineageTag: 7a657520-77e1-41a6-bd8c-51cdbee5282c

	measure Debit_vs_Credit = ```
			
			 VAR DEBIT_=
			 CALCULATE(sum(L_Entries[Debit_Amount]),ALLEXCEPT(L_Entries, L_Entries[G_L_Account_No],L_Entries[Posting_Date]),
			
			        KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), TREATAS (
			            VALUES ( DimCalendar[CalendarDate] ),
			            L_Entries[Posting_Date]
			        )
			)
			 VAR CREDIT_= 
			  CALCULATE(sum(L_Entries[Credit_Amount]),ALLEXCEPT(L_Entries, L_Entries[G_L_Account_No],L_Entries[Posting_Date]),
			
			        KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), TREATAS (
			            VALUES ( DimCalendar[CalendarDate] ),
			            L_Entries[Posting_Date]
			        )
			)
			  RETURN
			  IF(ISBLANK(DEBIT_),0,DEBIT_)-  IF(ISBLANK(CREDIT_),0,CREDIT_)
			  
			```
		formatString: $#,0;($#,0);"-"
		displayFolder: 01-General
		lineageTag: 9c91bc74-ce7b-4aa3-ad09-a26a5a61a134

		annotation PBI_FormatHint = {"isGeneralNumber":true}

		annotation TabularEditor_Order = 24

	measure SalesF = ```
			
			
			 VAR DEBIT_=
			 CALCULATE(sum(L_Entries[Debit_Amount]),ALLEXCEPT(L_Entries, L_Entries[G_L_Account_No],L_Entries[Posting_Date]),
			VALUE(L_Entries[AccountNoNumeric]) >= 30001 &&
			        VALUE(L_Entries[AccountNoNumeric]) <= 30999,
			
			        KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), TREATAS (
			            VALUES ( DimCalendar[CalendarDate] ),
			            L_Entries[Posting_Date]
			        )
			
			)
			 VAR CREDIT_= 
			  CALCULATE(sum(L_Entries[Credit_Amount]),ALLEXCEPT(L_Entries, L_Entries[G_L_Account_No],L_Entries[Posting_Date]),
			VALUE(L_Entries[AccountNoNumeric]) >= 30001 &&
			        VALUE(L_Entries[AccountNoNumeric]) <= 30999,
			
			        KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), TREATAS (
			            VALUES ( DimCalendar[CalendarDate] ),
			            L_Entries[Posting_Date]
			        )
			
			)
			  RETURN
			  -1*(IF(ISBLANK(DEBIT_),0,DEBIT_)-  IF(ISBLANK(CREDIT_),0,CREDIT_))
			
			
			
			```
		formatString: $#,0;($#,0);"-"
		displayFolder: 01-General
		lineageTag: 7d462cd8-6f32-4c2e-8297-f912ebc4f60e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

		annotation TabularEditor_Order = 145

	measure SalesNF = ```
			
			 
			 VAR DEBIT_=
			 CALCULATE(sum(L_Entries[Debit_Amount]),ALLEXCEPT(L_Entries, L_Entries[G_L_Account_No],L_Entries[Posting_Date]),
			(VALUE(L_Entries[AccountNoNumeric]) >= 31000 &&
			        VALUE(L_Entries[AccountNoNumeric]) <= 31989)
			
			        ,
			
			        KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), TREATAS (
			            VALUES ( DimCalendar[CalendarDate] ),
			            L_Entries[Posting_Date]
			        )
			    
			)
			 VAR CREDIT_= 
			  CALCULATE(sum(L_Entries[Credit_Amount]),ALLEXCEPT(L_Entries, L_Entries[G_L_Account_No],L_Entries[Posting_Date]),
			(VALUE(L_Entries[AccountNoNumeric]) >= 31000 &&
			        VALUE(L_Entries[AccountNoNumeric]) <= 31989)
			
			        ,
			
			        KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), TREATAS (
			            VALUES ( DimCalendar[CalendarDate] ),
			            L_Entries[Posting_Date]
			        )
			
			)
			  RETURN
			 -1*( IF(ISBLANK(DEBIT_),0,DEBIT_)-  IF(ISBLANK(CREDIT_),0,CREDIT_))
			```
