			    SUM ( L_Entries[Amount] ),
			    L_Entries[G_L_Account_No] = "EMPCOUNT",
			
			    FILTER (
			        ALL ( L_Entries[Posting_Date] ),
			        L_Entries[Posting_Date] <= MaxDateLY
