	measure FreightOut = ```
			
			 VAR DEBIT_=
			 CALCULATE(sum(L_Entries[Debit_Amount]),ALLEXCEPT(L_Entries, L_Entries[G_L_Account_No],L_Entries[Posting_Date]),
			(
			  (VALUE(L_Entries[AccountNoNumeric]) >= 40992 &&
			        VALUE(L_Entries[AccountNoNumeric]) <= 40995 )    
			 || (VALUE(L_Entries[AccountNoNumeric]) IN {40997,4098,40999}))  ,
			
			        KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), TREATAS (
			            VALUES ( DimCalendar[CalendarDate] ),
			            L_Entries[Posting_Date]
			        )
			      
			)
			 VAR CREDIT_= 
			  CALCULATE(sum(L_Entries[Credit_Amount]),ALLEXCEPT(L_Entries, L_Entries[G_L_Account_No],L_Entries[Posting_Date]),
			(
			  (VALUE(L_Entries[AccountNoNumeric]) >= 40992 &&
			        VALUE(L_Entries[AccountNoNumeric]) <= 40995 )    
			 || (VALUE(L_Entries[AccountNoNumeric]) IN {40997,4098,40999}))  ,
			
			        KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), TREATAS (
			            VALUES ( DimCalendar[CalendarDate] ),
			            L_Entries[Posting_Date]
			        )
			   
			)  
			
			  RETURN
			  IF(ISBLANK(DEBIT_),0,DEBIT_)-  IF(ISBLANK(CREDIT_),0,CREDIT_)
			```
		formatString: $#,0;($#,0);"-"
		displayFolder: 01-General
		lineageTag: 9f819afa-06f8-49f4-a7e1-c99cdcefba0a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

		annotation TabularEditor_Order = 67

	measure CostOfSalesF = ```
			
			 
			VAR DEBIT_ =
			    CALCULATE(
			        SUM(L_Entries[Debit_Amount]),
			        ALLEXCEPT(
			            L_Entries,
			            L_Entries[G_L_Account_No],
			            L_Entries[Posting_Date]
			        ),
			        VALUE(L_Entries[AccountNoNumeric]) >= 40000 &&
			        VALUE(L_Entries[AccountNoNumeric]) <= 40799 || VALUE(L_Entries[AccountNoNumeric])=40989,
			
			        KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), TREATAS (
			            VALUES ( DimCalendar[CalendarDate] ),
			            L_Entries[Posting_Date]
			        )
			
			    )
			
			VAR CREDIT_ =
			    CALCULATE(
			        SUM(L_Entries[Credit_Amount]),
			        ALLEXCEPT(
			            L_Entries,
			            L_Entries[G_L_Account_No],
			            L_Entries[Posting_Date]
			        ),
			    VALUE(L_Entries[AccountNoNumeric]) >= 40000 &&
			        VALUE(L_Entries[AccountNoNumeric]) <= 40799 || VALUE(L_Entries[AccountNoNumeric])=40989,
			
			        KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), TREATAS (
			            VALUES ( DimCalendar[CalendarDate] ),
			            L_Entries[Posting_Date]
			        )
			
			    )
			
			RETURN
			    DEBIT_ - CREDIT_
			```
		formatString: $#,0;($#,0);"-"
		displayFolder: 01-General
		lineageTag: 9c62a85c-3ed9-49cc-8a3a-13b37014ae61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

		annotation TabularEditor_Order = 18

