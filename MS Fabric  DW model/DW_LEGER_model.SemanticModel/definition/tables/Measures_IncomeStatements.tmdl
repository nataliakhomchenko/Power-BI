			        )
			    )
			
			VAR CREDIT_ =
			    CALCULATE (
			        SUM ( L_Entries[Credit_Amount] ),
			
			        ALLEXCEPT (
			            L_Entries,
			            L_Entries[G_L_Account_No],
			            L_Entries[Posting_Date], L_Entries[Business_Unit_Code]
			        ),
			
			        L_Entries[G_L_Account_No]
			            IN  {"TNS-IC-NF","TNS-OS-NF"},
			
			        KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), TREATAS (
			            VALUES ( DimCalendar[CalendarDate] ),
			            L_Entries[Posting_Date]
			        )
			        )
			    
			
			RETURN
			    COALESCE ( DEBIT_, 0 )
			        - COALESCE ( CREDIT_, 0 )
			```
		formatString: #,0.0;(#,0.0);"-"
		displayFolder: 05-Other Income(Expense)
		lineageTag: ca2dd221-cdbc-4e72-a3e3-829f6ba64773

