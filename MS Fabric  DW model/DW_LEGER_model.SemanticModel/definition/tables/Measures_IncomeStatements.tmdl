	measure 'Net Income After Taxes' = ```
			
			VAR DEBIT_ =
			    CALCULATE(
			        SUM(L_Entries[Debit_Amount]),
			        VALUE(L_Entries[AccountNoNumeric]) >= 30000 &&
			        VALUE(L_Entries[AccountNoNumeric]) <= 99999,L_Entries[Source_Code] <> "CLSINCOME"
			    )
			VAR CREDIT_ =
			    CALCULATE(
			        SUM(L_Entries[Credit_Amount]),
			        VALUE(L_Entries[AccountNoNumeric]) >= 30000 &&
			        VALUE(L_Entries[AccountNoNumeric]) <= 99999,L_Entries[Source_Code] <> "CLSINCOME"
			    )
			RETURN
			COALESCE(DEBIT_,0) - COALESCE(CREDIT_,0)
			
			
			
			```
