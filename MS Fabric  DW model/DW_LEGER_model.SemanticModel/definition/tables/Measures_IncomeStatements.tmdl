			( VALUE(L_Entries[AccountNoNumeric]) >= 42000 &&
			       VALUE( L_Entries[AccountNoNumeric]) <= 42100) || VALUE(L_Entries[AccountNoNumeric]) IN{42190,42175}
			 ,
			
			        KEEPFILTERS(VALUES(DimBusinessUnit[Business_Unit_Code])), TREATAS (
			            VALUES ( DimCalendar[CalendarDate] ),
