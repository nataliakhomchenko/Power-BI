	measure Cash = ```
			
			VAR MaxDate = MAX(DimCalendar[CalendarDate])
			
			RETURN
			CALCULATE(
			    SUM(L_Entries[Amount]),
			
			
			    FILTER(
			        ALL(L_Entries),
			       VALUE( L_Entries[AccountNoNumeric]) >= 10000 &&
			       VALUE( L_Entries[AccountNoNumeric] )<= 10299
			    ),
			
			    
			    FILTER(
			        ALL(DimCalendar),
			        DimCalendar[CalendarDate] <= MaxDate
			    )
			)
			
			
