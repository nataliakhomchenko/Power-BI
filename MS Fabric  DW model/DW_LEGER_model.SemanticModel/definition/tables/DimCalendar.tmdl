table DimCalendar
	lineageTag: 5508efe2-dc3a-4fa4-b6b4-3aa79889783a
	sourceLineageTag: [dbo].[Calendar]
	dataCategory: Time

	measure Include_2_Year_Months_Filter = ```
			VAR SelYear = [Selected_Year M]
			
			// Check if a single Month is selected from your disconnected Calendar table
			VAR SelMonth = 
			    IF(
			        HASONEVALUE('Slicer Calendar Table'[Month]), 
			        SELECTEDVALUE('Slicer Calendar Table'[Month]), 
			        MAX('Slicer Calendar Table'[Month])
			    )
			
			VAR CurrentDimYear = MAX(DimCalendar[Year])
			VAR CurrentDimMonth = MAX(DimCalendar[MonthNo])
			
			VAR YearDiff = SelYear - CurrentDimYear
			
			RETURN
			IF(
			    ISBLANK(SelYear),
			    1, -- Show all if no year is selected
			    IF(
			        YearDiff >= 0 && YearDiff <= 1
			        && NOT(ISBLANK(SelMonth))
			        && CurrentDimMonth <= SelMonth,
			        1,
			        0
			    )
			)
			```
		lineageTag: 925e1ff7-0b27-46e5-a0df-ca0d1f1a094a

